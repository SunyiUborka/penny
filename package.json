{
  "name": "filler",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "git ls-files -zco --exclude-standard | xargs -0r prettier --ignore-unknown --write",
    "format:check": "git ls-files -zco --exclude-standard | xargs -0r prettier --ignore-unknown --check",
    "build": "npm run build --workspaces --if-present",
    "build:mobile": "MOBILE_API_BASE_URL=${MOBILE_API_BASE_URL:-https://bill.p1ckle.xyz/api} npm run build:mobile:run",
    "release:mobile": "npm run build:mobile && cd apps/mobile/android && ./gradlew assembleRelease",
    "dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build",
    "build:mobile:run": "VITE_API_BASE_URL=$MOBILE_API_BASE_URL npm run build -w @filler/web && npm run sync -w @filler/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vue-eslint-parser": "^9.4.3"
  }
}
