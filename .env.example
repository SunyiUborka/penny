# Mongo kapcsolati string (compose-ban a "mongo" service néven érhető el)
MONGO_URL=mongodb://mongo:27017/filler

# A megosztott jelszó, ember-olvashatóan (nincs felhasználónév). A backend
# induláskor memóriában argon2id hash-eli, plaintextként nem tárolja tovább.
# FONTOS: a Docker Compose interpolálja a $ jelet ebben a fájlban, ezért ha a
# jelszó tartalmaz $ karaktert, azt duplán írd (pl. jelszo$$ez), különben a
# jelszó csonkul, és a bejelentkezés meghibásodik.
APP_PASSWORD=

# Session cookie aláírásához használt titok, hosszú, random string.
SESSION_SECRET=

# getgeoapi.com API kulcs az árfolyam-lekéréshez. Csak a backend használja.
CURRENCY_API_KEY=

# getgeoapi.com convert végpont URL-je.
CURRENCY_API_URL=https://api.getgeoapi.com/v2/currency/convert

# development | production | test
NODE_ENV=development

# Backend HTTP port.
PORT=3000

# A `backup` service ezzel az uid/gid-del ír a ./backups könyvtárba, hogy a
# mentések ne rootként keletkezzenek, és a hostról is törölhetők legyenek.
# Az `id -u` és `id -g` kimenete. Megadás nélkül 1000:1000 az alapérték.
BACKUP_UID=1000
BACKUP_GID=1000

# Backend HTTP port a konténerben (a `web` service is ezen szólítja meg).
API_PORT=3000

# A `web` service belső portja, és amit a Caddy upstreamként használ.
WEB_PORT=8080

# A `web` service publikált portja a hoston.
WEB_HOST_PORT=8090

# A `mongo` service publikált portja a hoston.
MONGO_HOST_PORT=9879

# A Vite dev szerver portja (csak compose.dev.yaml).
WEB_DEV_PORT=5173

# A Caddy label: ezen a domainen szolgálja ki a web appot.
CADDY_HOST=bill.p1ckle.xyz

# A külső (már létező) Caddy docker network neve.
CADDY_NETWORK=caddy

# A `backup` service időzónája és megőrzési határai.
TZ=Europe/Budapest
KEEP_HOURLY_HOURS=24
KEEP_DAILY_DAYS=14
